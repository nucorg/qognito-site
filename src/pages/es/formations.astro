---
import '../../styles/formations.css';
import Layout from '../../layouts/Layout.astro';
import SagaProgramme from '../../components/SagaProgramme.astro';
import { positioning } from '../../content/positioning';
const copy = positioning.es;
---

<Layout title="Qognito.io | Formación SAGA-IA: decisiones y gobernanza de IA" description={copy.courseIntroduction} lang="es">
  <section class="hero-section" style="padding-bottom: 30px;">
    <div class="container hero-container">
      <span class="monospace-label">FORMACIÓN PARA QUIENES TOMAN DECISIONES</span>
      <h1 class="hero-title text-glow">Formación SAGA-IA<span class="logo-dot">.</span></h1>
      <p class="course-lead">{copy.courseLead}</p>
      <p class="hero-subtitle">{copy.coursePurpose}</p>
      <p class="hero-subtitle">{copy.courseContext}</p>
      <p class="hero-subtitle">{copy.courseIntroduction}</p>
    </div>
  </section>

  <SagaProgramme lang="es" />
</Layout>
