---
import { whitepaper, whitepaperPath, collectionEnabled } from '../config/whitepaper';
import type { SiteLocale } from '../config/locales';
import PriceBadge from './PriceBadge.astro';
import { priceLabels } from '../content/pricing';

interface Props {
  lang?: SiteLocale;
  variant?: 'default' | 'card';
}

const { lang = 'fr', variant = 'default' } = Astro.props;
const copy = {
  fr: {
    label: 'Livre blanc Qognito',
    audience: 'LIVRE BLANC · DG, DAF & DSI',
    title: whitepaper.title,
    description: 'Supervision humaine, coûts complets, temps réaffecté : examinez les angles morts du ROI de vos projets IA.',
    download: 'Je télécharge le livre blanc',
    discover: 'Je découvre le livre blanc',
  },
  en: {
    label: 'Qognito white paper',
    audience: 'WHITE PAPER · CEOs, CFOs & CIOs',
    title: 'The AI Costs You Don’t See',
    description: 'Human oversight, total costs and reallocated time: examine the blind spots in your AI projects’ ROI.',
    download: 'Get my white paper',
    discover: 'Show me the white paper',
  },
  es: {
    label: 'Libro blanco de Qognito',
    audience: 'LIBRO BLANCO · DIRECCIÓN GENERAL, FINANCIERA Y DE SISTEMAS',
    title: 'La factura fantasma de la IA',
    description: 'Supervisión humana, costes completos y tiempo reasignado: examine los puntos ciegos del ROI de sus proyectos de IA.',
    download: 'Descargar el libro blanco',
    discover: 'Ver el libro blanco',
  },
}[lang];
---
<aside class:list={['whitepaper-callout', { 'offer-card': variant === 'card' }]} aria-label={copy.label} lang={lang}>
  {variant === 'card' && <PriceBadge value={priceLabels[lang].free} />}
  <div class:list={{ 'offer-card__body': variant === 'card' }}>
    <span>{copy.audience}</span>
    <h2>{copy.title}</h2>
    <p>{copy.description}</p>
    {lang !== 'fr' && <p class="language-note">{lang === 'en' ? 'PDF available in English.' : 'PDF disponible en español.'}</p>}
    {variant === 'card' && <a href={whitepaperPath(lang)} hreflang={lang}>{collectionEnabled ? copy.download : copy.discover} →</a>}
  </div>
  {variant === 'default' && <a class="btn-primary" href={whitepaperPath(lang)} hreflang={lang}>{collectionEnabled ? copy.download : copy.discover} →</a>}
</aside>
<style>
  .whitepaper-callout { margin: 2rem auto; padding: clamp(1.3rem, 4vw, 2.5rem); background: #0F2035; border: 1px solid #334155; border-left: 4px solid #D4850F; border-radius: 12px; display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; }
  .whitepaper-callout:not(.offer-card) > div { flex: 1 1 320px; }
  span { color: #D4850F; font-size: .8rem; letter-spacing: .08em; }
  h2 { font-size: 1.65rem; margin: .6rem 0; }
  p { margin: 0; color: #E2E8F0; }
  .language-note { margin-top: .6rem; font-size: .85rem; color: #CBD5E1; }
  a { flex-shrink: 0; white-space: normal; }
</style>
