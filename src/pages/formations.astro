<Layout title="Qognito.io | Catalogue des 3 Formations Officielles : BOOTAG-IA, SAGA-IA & REASON-IA" lang="fr">
  <!-- Header Page Formations -->
  <section class="hero-section" style="padding-bottom: 30px;">
    <div class="container hero-container">
      <span class="monospace-label">ACADÉMIE & CATALOGUE DE FORMATION</span>
      <h1 class="hero-title text-glow">
        Les 3 Formations Officielles d'Ingénierie Agentique<span class="logo-dot">.</span>
      </h1>
      <p class="hero-subtitle">
        Des modules d'ingénierie certifiants conçus pour les écoles d'ingénieurs, universités et écoles de commerce souhaitant former aux architectures d'agents autonomes, à leur gouvernance et au raisonnement avancé.
      </p>
    </div>
  </section>

  <!-- Section Catalogue des 3 Formations -->
  <section id="catalogue" class="section">
    <div class="container">
      <span class="monospace-label">Catalogue Officiel</span>
      <h2 class="section-title">La Triade des Formations Qognito.io</h2>
      <p class="section-subtitle">
        Une approche orientée "Principes Premiers" : plomberie d'API, typage strict, gouvernance FinOps (C<sub>task</sub>) et apprentissage par renforcement (RLVR).
      </p>

      <div class="grid-3" style="margin-top: 30px;">
        <!-- Formation 1 : BOOTAG-IA -->
        <div class="glow-card" style="border: 1px solid #D4850F; background-color: #1E293B; padding: 25px; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 5px;">
              <span style="background-color: #D4850F; color: #0A1628; padding: 4px 10px; border-radius: 4px; font-weight: bold; font-size: 0.8rem;">DISPONIBLE</span>
