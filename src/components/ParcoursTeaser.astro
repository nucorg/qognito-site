---
import { parcours } from '../content/parcours';
import { pathForRoute, type SiteLocale } from '../config/locales';
interface Props { lang: SiteLocale; }
const { lang } = Astro.props;
const copy = parcours[lang];
---
<section class="parcours-teaser" aria-labelledby="parcours-teaser-title">
  <div class="container">
    <span class="monospace-label">{copy.teaserLabel}</span>
    <h2 id="parcours-teaser-title">{copy.teaserTitle}</h2>
    <p>{copy.teaserText}</p>
    <a href={pathForRoute('parcours', lang)}>{copy.teaserLink} <span aria-hidden="true">→</span></a>
  </div>
</section>
<style>
  .parcours-teaser { background: #0F2035; padding-block: clamp(2.5rem, 5vw, 4rem); margin-top: 4rem; border-block: 1px solid var(--color-border); text-align: center; }
  h2 { font-weight: 600; font-size: clamp(1.5rem, 3vw, 1.8rem); }
  p { max-width: 720px; margin: 0 auto 1rem; color: #E2E8F0; }
  a { display: inline-block; padding-block: .75rem; }
  a:focus-visible { outline: 3px solid #D4850F; outline-offset: 4px; }
</style>
