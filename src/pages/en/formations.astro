---
import '../../styles/formations.css';
import Layout from '../../layouts/Layout.astro';
import SagaCard from '../../components/SagaCard.astro';
import TechnicalCourseProgramme from '../../components/TechnicalCourseProgramme.astro';
import SagaProgramme from '../../components/SagaProgramme.astro';
import TrainingContact from '../../components/TrainingContact.astro';
import { positioning } from '../../content/positioning';
const copy = positioning.en;

---

<Layout title="Qognito.io | AI Courses: SAGA-IA, BOOTAG-IA & REASON-IA" description={copy.courseIntroduction} lang="en">
  <!-- Header Page Formations -->
  <section class="hero-section" style="padding-bottom: 30px;">
    <div class="container hero-container">
      <span class="monospace-label">ACADEMY & TRAINING CATALOGUE</span>
      <h1 class="hero-title text-glow">
        Qognito courses<span class="logo-dot">.</span>
      </h1>
      <p class="course-lead">{copy.courseLead}</p>
      <p class="hero-subtitle">{copy.courseContext}</p>
      <p class="hero-subtitle">{copy.courseIntroduction}</p>
    </div>
  </section>

  <!-- Section Catalogue des 3 Formations -->
  <section id="catalogue" class="section">
    <div class="container">
      <span class="monospace-label">Course catalogue</span>
      <h2 class="section-title">Three complementary courses</h2>
      <p class="section-subtitle">{copy.courseChoice}</p>

      <div class="grid-3" style="margin-top: 30px;">
        <!-- SAGA-IA catalogue -->
        <SagaCard lang="en" variant="catalogue" />

        <!-- Program 2 : BOOTAG-IA -->
        <div class="glow-card bootag-course" style="border: 1px solid var(--color-primary); background-color: #1E293B; padding: 25px; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 5px;">
              <span class="course-audience" style="color: var(--color-primary);">{copy.bootag.label}</span>
              <span style="color: #38bdf8; font-family: monospace; font-size: 0.9rem;">28h (4 Days)</span>
            </div>
            <h3 class="card-title" style="color: #f8fafc; font-size: 1.4rem; margin-bottom: 5px;">BOOTAG-IA</h3>
            <p style="color: #94a3b8; font-size: 0.85rem; font-weight: bold; margin-bottom: 15px;">Agentic Harness Engineering</p>
            <p class="card-text" style="color: #cbd5e1; margin-bottom: 20px; font-size: 0.9rem; line-height: 1.5;">
              {copy.bootag.summary}
            </p>
            <p class="course-readership">{copy.bootag.audience}</p>
          </div>
          <a href="#fiche-bootag-ia" class="course-discover">Show me BOOTAG-IA ↓</a>
        </div>

        <!-- Program 3 : REASON-IA -->
        <div class="glow-card" style="border: 1px solid #10b981; background-color: #1E293B; padding: 25px; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 5px;">
              <span class="course-audience" style="color: #10b981;">{copy.reason.label}</span>
              <span style="color: #10b981; font-family: monospace; font-size: 0.9rem;">40h (5 Days)</span>
            </div>
            <h3 class="card-title" style="color: #f8fafc; font-size: 1.4rem; margin-bottom: 5px;">REASON-IA</h3>
            <p style="color: #94a3b8; font-size: 0.85rem; font-weight: bold; margin-bottom: 15px;">Reasoning, Emergence & Reinforcement Learning</p>
            <p class="card-text" style="color: #cbd5e1; margin-bottom: 20px; font-size: 0.9rem; line-height: 1.5;">
              {copy.reason.summary}
            </p>
            <p class="course-readership">{copy.reason.audience}</p>
          </div>
          <a href="#fiche-reason-ia" class="course-discover" style="--color-primary: #10b981; --color-primary-rgb: 16, 185, 129;">Show me REASON-IA ↓</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact and course overviews -->
  <TrainingContact lang="en" />

  <div id="fiches-institutionnelles">
    <!-- SAGA-IA : programme pour décideurs -->
    <SagaProgramme lang="en" />

    <!-- SHEET 2 : BOOTAG-IA -->
    <TechnicalCourseProgramme lang="en" course="bootag" />

    <!-- SHEET 3 : REASON-IA -->
    <TechnicalCourseProgramme lang="en" course="reason" />
  </div>
</Layout>
