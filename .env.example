# Variables publiques intégrées au HTML lors du build Cloudflare Pages.
# La clé Web3Forms est un identifiant public de formulaire, pas un secret serveur.
PUBLIC_WEB3FORMS_ACCESS_KEY=
PUBLIC_WHITEPAPER_ENABLED=false
# Informations de confidentialité relatives à la boîte destinataire.
PUBLIC_MAIL_PROVIDER=
PUBLIC_MAIL_LOCATION=
PUBLIC_MAIL_SAFEGUARDS=
