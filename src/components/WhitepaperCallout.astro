---
import { whitepaper, whitepaperPath, collectionEnabled } from '../config/whitepaper';

interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props;
const copy = {
  fr: {
    label: 'Livre blanc Qognito',
    audience: 'LIVRE BLANC · DG, DAF & DSI',
    title: whitepaper.title,
    description: 'Supervision humaine, coûts complets, temps réaffecté : examinez les angles morts du ROI de vos projets IA.',
    download: 'Je télécharge le livre blanc',
    discover: 'Je découvre le livre blanc',
  },
  en: {
    label: 'Qognito white paper',
    audience: 'WHITE PAPER · CEOs, CFOs & CIOs',
    title: 'The AI Costs You Don’t See',
    description: 'Human oversight, total costs and reallocated time: examine the blind spots in your AI projects’ ROI.',
    download: 'Get my white paper',
    discover: 'Show me the white paper',
  },
}[lang];
---
<aside class="whitepaper-callout" aria-label={copy.label} lang={lang}>
  <div>
    <span>{copy.audience}</span>
    <h2>{copy.title}</h2>
    <p>{copy.description}</p>
    {lang === 'en' && <p class="language-note">PDF available in English.</p>}
  </div>
  <a class="btn-primary" href={whitepaperPath(lang)} hreflang={lang}>{collectionEnabled ? copy.download : copy.discover} →</a>
</aside>
<style>
  .whitepaper-callout { margin: 2rem auto; padding: clamp(1.3rem, 4vw, 2.5rem); background: #0F2035; border: 1px solid #334155; border-left: 4px solid #D4850F; border-radius: 12px; display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; }
  .whitepaper-callout div { flex: 1 1 320px; }
  span { color: #D4850F; font-size: .8rem; letter-spacing: .08em; }
  h2 { font-size: 1.65rem; margin: .6rem 0; }
  p { margin: 0; color: #E2E8F0; }
  .language-note { margin-top: .6rem; font-size: .85rem; color: #CBD5E1; }
  a { flex-shrink: 0; white-space: normal; }
</style>
