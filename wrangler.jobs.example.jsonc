{
  "name": "qognito-commerce-jobs-staging",
  "main": "workers/commerce-jobs.mjs",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "COMMERCE_MODE": "test",
    "COMMERCE_ORIGIN": "https://REPLACE-STAGING-ORIGIN",
    "COMMERCE_FROM": "Qognito <commandes@transaction.qognito.io>"
  },
  "d1_databases": [{ "binding": "COMMERCE_DB", "database_name": "qognito-commerce-staging", "database_id": "REPLACE-D1-ID" }],
  "r2_buckets": [{ "binding": "COMMERCE_PDF", "bucket_name": "qognito-commerce-staging" }]
}
