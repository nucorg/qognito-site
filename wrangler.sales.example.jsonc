{
  "name": "qognito-commerce-staging",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "COMMERCE_MODE": "test",
    "COMMERCE_CHECKOUT_ENABLED": "false",
    "COMMERCE_ORIGIN": "https://REPLACE-STAGING-ORIGIN",
    "COMMERCE_FROM": "Qognito <commandes@transaction.qognito.io>",
    "COMMERCE_PHONE": "+33 7 62 64 05 06"
  },
  "d1_databases": [{"binding":"COMMERCE_DB","database_name":"qognito-commerce-staging","database_id":"REPLACE-D1-ID","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"COMMERCE_PDF","bucket_name":"qognito-commerce-staging"}]
}
