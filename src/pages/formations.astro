        </div>

        <!-- Programme 3 : REASON-IA -->
        <div class="glow-card" style="border-left: 4px solid #10b981; background-color: #1E293B;">
          <span style="color: #10b981; font-size: 0.8rem; font-weight: bold; letter-spacing: 1px;">DEEP TECH & R&D (40H)</span>
          <h3 style="color: #f8fafc; font-size: 1.3rem; margin: 10px 0;">REASON-IA : Raisonnement & RLVR</h3>
